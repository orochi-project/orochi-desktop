[sub_resource type="GDScript" id="GDScript_qel0l"]
script/source = "extends Parallax2D

## Movement speed in pixels per second.
@export var movement_velocity: float = 60.0

## Width of one image in pixels.
@export var texture_width: float = 1920.0


func _process(delta: float) -> void:
	position.x += movement_velocity * delta

	if position.x >= texture_width:
		position.x -= texture_width
	elif position.x <= -texture_width:
		position.x += texture_width
"

