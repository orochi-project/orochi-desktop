[sub_resource type="GDScript" id="GDScript_lqpn7"]
script/source = "extends ScrollContainer

@export var drag_threshold := 10.0  # how much pixels to move until it counts as a drag 

var just_dragged := false
var _pressing := false
var _dragging := false
var _start_x := 0.0
var _start_scroll := 0

func _input(event: InputEvent) -> void:
	# checks if left mouse button was either lifted or pressed
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		# if left mouse button was pressed, change variable boolean only if
		# the click was inside the scroll bar
		if event.pressed:
			if get_global_rect().has_point(event.global_position):
				_pressing = true
				_dragging = false
				_start_x = event.global_position.x
				_start_scroll = scroll_horizontal
		else:
			if _dragging:
				just_dragged = true
				_clear_just_dragged()
			_pressing = false
			_dragging = false

	elif event is InputEventMouseMotion and _pressing:
		# calculates how far the mouse moved while pressing to determine
		# whether it passes drag_threshold and counts as a drag
		var dx: float = event.global_position.x - _start_x
		if not _dragging and abs(dx) > drag_threshold:
			_dragging = true
		if _dragging:
			scroll_horizontal = _start_scroll - int(dx)
			get_viewport().set_input_as_handled()

func _clear_just_dragged() -> void:
	await get_tree().process_frame
	just_dragged = false
	
func _on_play_pressed() -> void:
	if $Control/ColorRect/ScrollContainer.just_dragged:
		return
"

